# Public origin of the deployed site — used for canonical URLs, robots.txt,
# the sitemap and Open Graph tags. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase Postgres connection string, read by prisma.config.ts (migrations)
# and lib/prisma.ts (the app).
#
# Supabase → Project Settings → Database gives you two:
#   • Direct connection  (…db.<ref>.supabase.co:5432)  — one long-lived pool.
#     Right for `next start` on a real server and for `prisma migrate`.
#   • Transaction pooler (…pooler.supabase.com:6543)   — pgbouncer.
#     Use this for the app on serverless (Vercel), where every invocation
#     would otherwise open its own connection. Add `?pgbouncer=true`.
#     Migrations still need the direct URL.
DATABASE_URL="postgresql://postgres:PASSWORD@db.<project-ref>.supabase.co:5432/postgres"

# Resend API key — transactional email (the waitlist confirmation).
# Without it signups are still saved; the confirmation is skipped with a warning.
RESEND_API_KEY=

# Optional. Overrides the From address, which defaults to
# "Rockstar <support@naviteklabs.com>". Point it at "onboarding@resend.dev"
# if you're developing without access to the verified domain.
RESEND_FROM=

# Optional. The display name on mail sent by the BeautyUni site — the join
# form's welcome and the seminar survey's receipt. Both default to
# "BeautyUni <…>" on the same verified mailbox as RESEND_FROM, so neither is
# normally set.
RESEND_FROM_SITE=
RESEND_FROM_SEMINAR=
