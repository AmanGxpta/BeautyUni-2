// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per person who joins the RS Community.
///
/// `email` is unique so a repeat submission updates the same person rather
/// than making a second row — `joinWaitlist` reports it back as
/// `alreadyOnList` and skips a second confirmation email. Addresses are
/// normalized (trimmed + lowercased) before they get here, so the unique
/// index is doing real work rather than letting case variants through.
///
/// `source` stays a plain string rather than a Postgres enum: it records
/// which CTA opened the join dialog, and a new CTA should not need a
/// migration before it can start collecting.
///
/// Every field below `phone` is post-seminar feedback. The form requires all
/// of them, but the columns stay nullable for the rows written before the
/// feedback form existed — a NOT NULL here would either reject that history
/// or need a made-up answer backfilled into it.
model WaitlistSignup {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?

  /// The whole number in E.164, e.g. `+919876543210` — dialling code, national
  /// number, no separators.
  ///
  /// The form still asks for the code and the number as two controls, because
  /// picking a country beats typing `+971`; they are joined on the way in. One
  /// column is what anyone reading or exporting this table actually wants, and
  /// it costs only the ability to say *which* country a shared code like +1
  /// belonged to — which is not something we ask for or report on.
  phoneNumber String? @map("phone_number")

  /// Q4 — "Did we solve any of your challenges?"
  solvedChallenges     Boolean? @map("solved_challenges")
  /// Q5 — "Did you love the Rockstar leaders growth seminar?"
  lovedSeminar         Boolean? @map("loved_seminar")
  /// Q6 — "What was your No. 1 takeaway?"
  topTakeaway          String?  @map("top_takeaway")
  /// Q7 — "What would you implement in your salon tomorrow?"
  implementTomorrow    String?  @map("implement_tomorrow")
  /// Q8 — "Will this change how you communicate with your team?"
  changesTeamComms     Boolean? @map("changes_team_comms")
  /// Q9 — "Would the Rockstar way of communication help you deliver the
  /// perfect guest experience?"
  helpsGuestExperience Boolean? @map("helps_guest_experience")
  /// Q10 — "Anything we could add to our journey of education in India?"
  educationIdeas       String?  @map("education_ideas")

  source    String   @default("api")
  createdAt DateTime @default(now()) @map("created_at")
  /// Moves when someone re-submits the form. Without it a revised answer is
  /// indistinguishable from the original signup, and the answers are now the
  /// point of the row.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("waitlist_signups")
}

/// One row per person who answers the Rockstar 2-Day Seminar Feedback Survey
/// at `/seminar-feedback`.
///
/// Its own table rather than more columns on `WaitlistSignup`: the two forms
/// ask different questions of different people at different moments, and
/// folding them together would give every waitlist row nine NULL survey
/// answers and every response seven NULL waitlist answers. Keeping them apart
/// also lets this table hold its required answers NOT NULL — something
/// `WaitlistSignup` cannot do, because it has history that predates its own
/// questions.
///
/// `email` is unique so a second submission revises the same response rather
/// than making a second row; `recordSeminarFeedback` reports that back as
/// `alreadyResponded` and skips a second confirmation email.
///
/// The scale answers are `String`, not a Postgres enum, and hold short stable
/// slugs (`very_good`, `not_confident_yet`) rather than the labels shown on
/// the page. The slug is the answer and the label is copy: rewording "Very
/// good" must not split one rating across two spellings in the data, and
/// adding a scale point should not need a migration before the survey can
/// collect it. `lib/seminar-survey.ts` is the list of accepted values, and it
/// is checked per question rather than across all of them.
model SeminarFeedback {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// The whole number in E.164, e.g. `+919876543210` — dialling code,
  /// national number, no separators. The form asks for the code and the
  /// number as two controls; they are joined on the way in.
  phoneNumber String @map("phone_number")

  /// Q1 — overall experience across the two days. See `RATING_SCALE`.
  overallRating    String @map("overall_rating")
  /// Q2 — relevance to their role, salon, or business goals.
  contentRelevance String @map("content_relevance")
  /// Q3 — the session, speaker, topic, or activity with the greatest impact.
  greatestImpact   String @map("greatest_impact")
  /// Q4 — confidence about applying what they learned.
  applyConfidence  String @map("apply_confidence")
  /// Q5 — one action, change, or strategy for the next 30 days.
  thirtyDayAction  String @map("thirty_day_action")
  /// Q6 — the speakers and facilitators.
  speakerRating    String @map("speaker_rating")
  /// Q7 — the event: venue, timing, registration, hospitality, organisation.
  eventRating      String @map("event_rating")

  /// Q8 — what would make the next seminar more valuable. Optional: a
  /// required "any suggestions?" collects "na", not suggestions.
  improvementIdeas String?  @map("improvement_ideas")
  /// Q9 — a short testimonial. Optional, because the question itself asks
  /// whether they would be *comfortable* giving one.
  testimonial      String?
  /// Q9's follow-on — may we use this in social or promotional material?
  ///
  /// Nullable, and NULL means they didn't say. That is not the same as "no"
  /// and must never collapse into it: this is the column anyone would be
  /// pointed at if a respondent ever objected to being quoted.
  promoConsent     Boolean? @map("promo_consent")

  createdAt DateTime @default(now()) @map("created_at")
  /// Moves when someone re-submits. Without it a revised answer is
  /// indistinguishable from the original response.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([createdAt])
  @@map("seminar_feedback")
}
